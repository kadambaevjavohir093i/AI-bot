{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE"
  },
  "deploy": {
    "startCommand": "python run_inspection.py",
    "healthcheckPath": "/",
    "restartPolicyType": "ON_FAILURE",
    "volumes": [
      {
        "mountPath": "/data"
      }
    ]
  }
}
