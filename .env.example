# Telegram
TELEGRAM_BOT_TOKEN=

# Anthropic (Claude) for generating call dialogue
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Public HTTPS URL where Twilio can reach this app (e.g. an ngrok tunnel
# during development, or your real domain in production). No trailing slash.
PUBLIC_BASE_URL=

# Host/port the FastAPI voice webhook server binds to
VOICE_APP_HOST=0.0.0.0
VOICE_APP_PORT=8000
